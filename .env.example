# ==========================================
# ReguLens Environment Configuration Example
# ==========================================

# ------------------------------------------
# Backend Settings (Render / Local)
# ------------------------------------------
APP_NAME=ReguLens
ENVIRONMENT=development

# Database Connection URL:
# - Local SQLite (default fallback): sqlite:///./regulens.db
# - Local PostgreSQL: postgresql://regulens:regulens@localhost:5432/regulens
# - Render / Cloud PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=sqlite:///./regulens.db

# ------------------------------------------
# AI Provider Configuration
# ------------------------------------------
# Options: gemini (Primary) | nvidia (Secondary / Fallback)
AI_PROVIDER=gemini
AI_FALLBACK_ENABLED=true

# NVIDIA Nemotron Configuration (Get from https://build.nvidia.com/)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Google Gemini Configuration (Fallback / Secondary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_RISHAV=your_rishav_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.6-flash

# Secret key used for signing session tokens
SECRET_KEY=regulens_sih_prototype_secret_key_change_in_production

# PDF Upload Size Limit (in MB)
MAX_UPLOAD_SIZE_MB=20

# Optional Demo Account Seeding (true / false)
SEED_DEMO_USER=true
DEMO_USER_EMAIL=admin@regulens.ai
DEMO_USER_PASSWORD=Admin@123
DEMO_USER_NAME="Compliance Officer"

# Allowed CORS Origins (comma-separated or JSON list):
# - Local: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# - Production: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------
# Frontend Settings (Vercel / Local)
# ------------------------------------------
# - Local Development: http://127.0.0.1:8000
# - Production (Render backend URL): https://your-backend-service.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
